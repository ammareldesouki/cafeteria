# ─── Better Auth ───────────────────────────────────────
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=https://your-app.up.railway.app

# ─── Database ──────────────────────────────────────────
DATABASE_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/cic_main

# ─── App ───────────────────────────────────────────────
PORT=3001

# ─── Logging ───────────────────────────────────────────
LOG_DIR=logs
LOG_LEVEL=info

# ─── CORS ──────────────────────────────────────────────
ORIGIN=https://your-frontend-domain.com
CREDENTIALS=true
CORS_ORIGINS=https://your-frontend-domain.com

# ─── Server ────────────────────────────────────────────
API_SERVER_URL=https://your-app.up.railway.app

# ─── Optional ──────────────────────────────────────────
SENTRY_DSN=
REDIS_URL=redis://localhost:6379

# ─── SMTP (Gmail) — for password reset emails ──────────
# 1) Enable 2-Step Verification on your Google account
# 2) Go to Google Account → Security → App Passwords → create one
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM=your_email@gmail.com
