{
	"name": "default",
	"version": "1.0.0",
	"description": "default template",
	"scripts": {
		"start": "cross-env NODE_ENV=production node dist/server.js",
		"dev": "cross-env NODE_ENV=development nodemon",
		"dev:watch": "tsx watch src/server.ts",
		"build": "tsc && tsc-alias",
		"lint": "biome lint .",
		"check": "biome check .",
		"format": "biome format . --write",
		"start:tsup": "node -r tsconfig-paths/register dist/server.js",
		"build:tsup": "tsup --config tsup.config.ts",
		"deploy:prod": "pm2 start ecosystem.config.js --only prod",
		"deploy:dev": "pm2 start ecosystem.config.js --only dev"
	},
	"dependencies": {
		"better-auth": "^1.4.13",
		"cors": "^2.8.5",
		"dotenv": "^17.2.1",
		"express": "^5.1.0",
		"express-rate-limit": "^8.0.1",
		"mongodb": "^7.0.0",
		"mongoose": "^9.1.3",
		"morgan": "^1.10.1",
		"nodemailer": "^8.0.5",
		"pm2": "^6.0.14",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.1.4",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/morgan": "^1.9.10",
		"@types/node": "^24.3.0",
		"@types/nodemailer": "^8.0.0",
		"cross-env": "^10.0.0",
		"node-gyp": "^11.4.2",
		"nodemon": "^3.1.10",
		"shadcn": "^4.1.1",
		"tsc-alias": "^1.8.16",
		"tsup": "^8.5.0",
		"tsx": "^4.20.5",
		"typescript": "^5.9.2"
	}
}
